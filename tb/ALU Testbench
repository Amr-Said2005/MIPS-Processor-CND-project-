module tb_alu ();

reg [31:0] tb_a;
reg [31:0] tb_b;
reg [5:0] tb_alu_ctrl;
wire [31:0] tb_result;
wire tb_zero;
wire tb_carry_out;
wire tb_overflow;
wire tb_negative;

alu uut(

.A(tb_a),
.B(tb_b),
.alu_ctrl(tb_alu_ctrl),
.Result(tb_result),
.Zero(tb_zero),
.CarryOut(tb_carry_out),
.Overflow(tb_overflow),
.Negative(tb_negative)
);


initial begin
    tb_a = 0; 
    tb_b = 0; 
    tb_alu_ctrl = 0;  
#10;

// Test 1 : ADD

tb_a = 32'h00000005; // 5
tb_b = 32'h0000000A; // 10
tb_alu_ctrl = 6'b000000;

#5;

if (tb_result != 32'h0000000F) begin
    $display("Addition failed to compile. Value = %h", tb_result);
end


#5;

// Test 2: SUB
tb_a = 32'h0000000A; // 10
tb_b = 32'h00000004; // 4
tb_alu_ctrl = 6'b000001; //Subtraction

#5;

if (tb_result != 32'h00000006) begin
    $display("Subtraction failed to compile. Value = %h", tb_result);
end


end

endmodule
